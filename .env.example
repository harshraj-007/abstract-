# Optional. Public repositories work without a token, within GitHub's limits.
# Use a token with minimal read permissions. Private repositories are rejected.
GITHUB_TOKEN=

# Persistent local directory. Defaults to .abstract/ in the project root.
ABSTRACT_DATA_DIR=.abstract

# Optional. The explorer and structural map work without Gemini.
# Used only after you choose to send the previewed source excerpts for an overview.
GEMINI_API_KEY=
# Explicit model ID supported by your account (without models/ or a URL).
# Model availability, quotas, and free-tier eligibility depend on the account.
GEMINI_MODEL=
